# Base Ubuntu image
FROM ubuntu:24.04

# Install Python and pip
RUN apt-get update && apt-get install -y python3 python3-pip

WORKDIR /app

# Copy project files before installing dependencies
COPY . .

# Install training and serving dependencies
RUN pip3 install --break-system-packages -r requirements-train.txt -r requirements-serve.txt

# Train the model inside the image
RUN python3 training/train.py --model-version 1.0.0

EXPOSE 8000

# Start the FastAPI server
CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

