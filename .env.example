DOCKERHUB_USERNAME=your-dockerhub-username

# Image tag, also used as the model version baked into the image (build argument)
IMAGE_TAG=1.0.0
MODEL_VERSION=1.0.0

# Git commit recorded in the image label and /model/info (set it with: git rev-parse --short HEAD)
GIT_SHA=unknown

# Host port that publishes the API (container port is always 8000)
HOST_PORT=8080

# Runtime settings passed to the API container
DECISION_THRESHOLD=0.5
LOG_LEVEL=INFO